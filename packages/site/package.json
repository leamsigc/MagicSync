{
  "name": "@local-monorepo/site",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=12288 nuxt build",
    "build:debug": "nuxt build --debug",
    "dev": "nuxt dev",
    "dev:debug": "nuxt dev --inspect",
    "generate": "nuxt generate",
    "preview": "nuxt preview --dotenv ../../.env ",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate --config ../db/config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ../db/config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ../db/config/drizzle.config.ts",
    "start": "node .output/server/index.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@iconify/utils": "catalog:",
    "@local-monorepo/agent": "workspace:*",
    "@local-monorepo/ai-tools": "workspace:*",
    "@local-monorepo/assets": "workspace:*",
    "@local-monorepo/auth": "workspace:*",
    "@local-monorepo/bulk-scheduler": "workspace:*",
    "@local-monorepo/connect": "workspace:*",
    "@local-monorepo/content": "workspace:*",
    "@local-monorepo/db": "workspace:*",
    "@local-monorepo/email": "workspace:*",
    "@local-monorepo/scheduler": "workspace:*",
    "@local-monorepo/templates": "workspace:*",
    "@local-monorepo/tools": "workspace:*",
    "@local-monorepo/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "@nuxtjs/mcp-toolkit": "catalog:",
    "better-auth": "catalog:",
    "nuxt": "catalog:",
    "nuxt-umami": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "unhead": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:",
    "evlog": "catalog:",
    "consola": "catalog:",
    "@comark/nuxt": "catalog:",
    "driver.js": "catalog:"
  },
  "devDependencies": {
    "@libsql/client": "catalog:",
    "@nuxt/hints": "catalog:",
    "@nuxt/vite-builder": "catalog:",
    "@nuxtjs/seo": "catalog:",
    "@playwright/test": "catalog:",
    "nuxtseo-layer-devtools": "catalog:"
  }
}