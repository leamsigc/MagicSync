{
  "name": "@local-monorepo/db",
  "type": "module",
  "version": "0.0.1",
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "nuxi dev .playground --dotenv ../../.env",
    "dev:prepare": "nuxt prepare .playground",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "preview": "nuxt preview .playground",
    "lint": "eslint .",
    "test:services": "node --test --import ./tests/register-hook.mjs --import ./tests/globals.mjs \"tests/*.test.mjs\"",
    "db:generate": "drizzle-kit generate --config ./config/drizzle.config.ts",
    "db:generate:local": "npx dotenv -e ../../.env -- drizzle-kit generate --config ./config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./config/drizzle.config.ts",
    "db:migrate:local": "npx dotenv -e ../../.env -- drizzle-kit migrate --config ./config/drizzle.config.ts",
    "db:studio": "npx dotenv -e ../../.env -- drizzle-kit studio --config ./config/drizzle.config.ts"
  },
  "dependencies": {
    "@local-monorepo/shared": "workspace:*",
    "dayjs": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@libsql/client": "catalog:",
    "@nuxt/eslint": "catalog:",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "jose": "^6.2.3",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:"
  }
}
