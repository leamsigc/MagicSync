{
  "schema": "magicsync/image-editor@1",
  "version": 1,
  "frame": { "width": 1080, "height": 1350, "fill": "#0f172a" },
  "fields": [
    { "name": "photo", "targets": [{ "objectId": "__background", "property": "image_url" }] },
    { "name": "eyebrow", "targets": [{ "objectId": "eyebrow", "property": "text" }] },
    { "name": "headline", "targets": [{ "objectId": "headline", "property": "text" }] },
    { "name": "body", "targets": [{ "objectId": "body", "property": "text" }] },
    { "name": "cta", "targets": [{ "objectId": "cta", "property": "text" }] }
  ],
  "meta": { "title": "Photo-led feed post", "category": "social", "tags": ["template", "photo"] },
  "pages": [
    {
      "id": "page-1",
      "name": "Page 1",
      "duration": 4000,
      "objects": [
        {
          "id": "__background",
          "type": "image",
          "name": "{photo}",
          "src": "https://images.unsplash.com/photo-1635776062360-af423602aff3?crop=entropy&cs=tinysrgb&fit=crop&fm=jpg&q=80&w=1080&h=1350",
          "left": 0,
          "top": 0,
          "width": 1080,
          "height": 1350,
          "originX": "left",
          "originY": "top",
          "selectable": false,
          "evented": false,
          "crossOrigin": "anonymous"
        },
        {
          "id": "overlay",
          "type": "rect",
          "left": 0,
          "top": 0,
          "width": 1080,
          "height": 1350,
          "fill": "#0f172a",
          "opacity": 0.5
        },
        {
          "id": "eyebrow",
          "type": "textbox",
          "name": "{eyebrow}",
          "left": 76,
          "top": 880,
          "width": 700,
          "text": "NEW ARRIVAL",
          "fontSize": 32,
          "fontFamily": "Arial",
          "fontWeight": "bold",
          "fill": "#22d3ee",
          "textAlign": "left",
          "lineHeight": 1.2,
          "originX": "left",
          "originY": "top"
        },
        {
          "id": "headline",
          "type": "textbox",
          "name": "{headline}",
          "left": 76,
          "top": 940,
          "width": 900,
          "text": "Made for\nthe moment",
          "fontSize": 104,
          "fontFamily": "Archivo Black",
          "fontWeight": "bold",
          "fill": "#ffffff",
          "textAlign": "left",
          "lineHeight": 0.98,
          "originX": "left",
          "originY": "top"
        },
        {
          "id": "body",
          "type": "textbox",
          "name": "{body}",
          "left": 76,
          "top": 1180,
          "width": 760,
          "text": "A short supporting line goes here.",
          "fontSize": 36,
          "fontFamily": "Arial",
          "fontWeight": "normal",
          "fill": "#e2e8f0",
          "textAlign": "left",
          "lineHeight": 1.3,
          "originX": "left",
          "originY": "top"
        },
        {
          "id": "cta-bg",
          "type": "rect",
          "left": 76,
          "top": 1250,
          "width": 320,
          "height": 84,
          "rx": 42,
          "ry": 42,
          "fill": "#22d3ee"
        },
        {
          "id": "cta",
          "type": "textbox",
          "name": "{cta}",
          "left": 76,
          "top": 1272,
          "width": 320,
          "text": "SHOP NOW",
          "fontSize": 28,
          "fontFamily": "Arial",
          "fontWeight": "bold",
          "fill": "#0f172a",
          "textAlign": "center",
          "lineHeight": 1.2,
          "originX": "left",
          "originY": "top"
        }
      ],
      "background": { "fill": "#0f172a" },
      "animation": { "layers": {} }
    }
  ]
}
